        "rc"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "ErrorKind": {
      "enum": [
        "syntax",
        "command_not_found",
        "varname_not_found",
        "invalid_name",
        "type_mismatch",
        "name_conflict",
        "not_sorted",
        "convergence",
        "infeasible",
        "estimation_sample_empty",
        "estimation_failure",
        "no_estimation_results",
        "no_observations",
        "data_in_memory",
        "matrix_singular",
        "matrix_conformability",
        "matrix_missing",
        "file_not_found",
        "file_exists",
        "file_corrupt",
        "file_io",
        "network",
        "permission",
        "encoding",
        "stata_limit",
        "out_of_memory",
        "interrupt",
        "cancelled",
        "timeout",
        "adapter_crash",
        "policy_blocked",
        "unknown"
