    "EstimationResult": {
      "additionalProperties": true,
      "description": "Typed coefficient table derived from ``r(table)`` or ``e(b)``/``e(V)``.\n\n``source`` records provenance: ``\"r_table\"`` means the values are exactly\nwhat Stata displayed (referee-grade); ``\"e_b_v\"`` means they were computed\nfrom the coefficient vector and its VCV under a normal approximation.",
      "properties": {
        "ci_level": {
          "default": 95.0,
          "title": "Ci Level",
          "type": "number"
        },
        "coefficients": {
          "items": {
            "$ref": "#/$defs/Coefficient"
          },
          "title": "Coefficients",
          "type": "array"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "command_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Family"
        },
        "depvar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depvar"
        },
        "df_model": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Df Model"
        },
        "df_resid": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Df Resid"
        },
        "diagnostics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Diagnostics",
          "type": "object"
        },
        "model_stats": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Model Stats",
          "type": "object"
        },
        "n_obs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Obs"
        },
        "source": {
          "default": "r_table",
          "enum": [
            "r_table",
            "e_b_v"
          ],
          "title": "Source",
          "type": "string"
        },
        "statistic_kind": {
          "default": "z",
          "enum": [
            "t",
            "z"
          ],
          "title": "Statistic Kind",
          "type": "string"
        }
      },
      "title": "EstimationResult",
      "type": "object"
    },
