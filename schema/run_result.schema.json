          "title": "Rc",
          "type": "integer"
        },
        "rc_label": {
          "default": "",
          "title": "Rc Label",
          "type": "string"
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recovery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
