{
  "name": "stata-code-vscode",
  "displayName": "stata-code",
  "description": "Run Stata code from VSCode through the agent-native stata-code MCP server.",
  "version": "0.6.1",
  "publisher": "brycewang-stanford",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brycewang-stanford/stata-code.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Data Science", "Notebooks"],
  "keywords": ["stata", "pystata", "mcp", "causal-inference"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:stata"],
  "contributes": {
    "languages": [
      {
        "id": "stata",
        "aliases": ["Stata", "stata"],
        "extensions": [".do", ".ado", ".mata"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stata",
        "scopeName": "source.stata",
        "path": "./syntaxes/stata.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "stataCode.runSelection",
        "title": "Stata: Run Selection / Current Line",
        "category": "stata-code",
        "icon": {
          "light": "resources/icons/stata-run-selection.svg",
          "dark": "resources/icons/stata-run-selection.svg"
        }
      },
      {
        "command": "stataCode.runFile",
        "title": "Stata: Run All / Active File",
        "category": "stata-code",
        "icon": {
          "light": "resources/icons/stata-run-all.svg",
          "dark": "resources/icons/stata-run-all.svg"
        }
      },
      {
        "command": "stataCode.runCell",
        "title": "Stata: Run Cell",
        "category": "stata-code"
      },
      {
        "command": "stataCode.runSection",
        "title": "Stata: Run Current Section",
        "category": "stata-code",
        "icon": "$(play)"
      },
      {
        "command": "stataCode.openHelpForSelection",
        "title": "Stata: Open Help for Selection",
        "category": "stata-code",
        "icon": "$(question)"
      },
      {
        "command": "stataCode.insertContinuation",
        "title": "Stata: Insert Line Continuation",
        "category": "stata-code",
        "icon": "$(newline)"
      },
      {
        "command": "stataCode.showLastResult",
        "title": "Stata: Show Last Result (JSON)",
        "category": "stata-code"
      },
      {
        "command": "stataCode.openRunResult",
        "title": "Stata: Open Run Result (JSON)",
        "category": "stata-code"
      },
      {
        "command": "stataCode.openMatrix",
        "title": "Stata: Open Matrix",
        "category": "stata-code"
      },
      {
        "command": "stataCode.viewDataPreview",
        "title": "Stata: View Data Preview",
        "category": "stata-code",
        "icon": {
          "light": "resources/icons/stata-data.svg",
          "dark": "resources/icons/stata-data.svg"
        }
      },
      {
        "command": "stataCode.rerunHistory",
        "title": "Stata: Rerun",
        "category": "stata-code",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "stataCode.copyRunCode",
        "title": "Stata: Copy Run Code",
        "category": "stata-code",
        "icon": "$(copy)"
      },
      {
        "command": "stataCode.exportRunBundle",
        "title": "Stata: Export Run Bundle...",
        "category": "stata-code",
        "icon": "$(archive)"
      },
      {
        "command": "stataCode.clearRunHistory",
        "title": "Stata: Clear Run History",
        "category": "stata-code",
        "icon": "$(trash)"
      },
      {
        "command": "stataCode.showGraphs",
        "title": "Stata: Show Graphs",
        "category": "stata-code",
        "icon": {
          "light": "resources/icons/stata-graphs.svg",
          "dark": "resources/icons/stata-graphs.svg"
        }
      },
      {
        "command": "stataCode.showOutput",
        "title": "Stata: Show Output",
        "category": "stata-code",
        "icon": {
          "light": "resources/icons/stata-output.svg",
          "dark": "resources/icons/stata-output.svg"
        }
      },
      {
        "command": "stataCode.statusBarMenu",
        "title": "Stata: Status Bar Actions...",
        "category": "stata-code"
      },
      {
        "command": "stataCode.switchSession",
        "title": "Stata: Switch Tab/Session...",
        "category": "stata-code",
        "icon": {
          "light": "resources/icons/stata-switch-tab.svg",
          "dark": "resources/icons/stata-switch-tab.svg"
        }
      },
      {
        "command": "stataCode.newSession",
        "title": "Stata: New Tab/Session...",
        "category": "stata-code",
        "icon": {
          "light": "resources/icons/stata-new-tab.svg",
          "dark": "resources/icons/stata-new-tab.svg"
        }
      },
      {
        "command": "stataCode.closeSession",
        "title": "Stata: Close Tab/Session",
        "category": "stata-code",
        "icon": "$(close)"
      },
      {
        "command": "stataCode.cancelSession",
        "title": "Stata: Stop / Cancel Current Session",
        "category": "stata-code",
        "icon": {
          "light": "resources/icons/stata-stop.svg",
          "dark": "resources/icons/stata-stop.svg"
        }
      },
      {
        "command": "stataCode.resetSession",
        "title": "Stata: Restart / Reset Current Session",
        "category": "stata-code",
        "icon": {
          "light": "resources/icons/stata-reset.svg",
          "dark": "resources/icons/stata-reset.svg"
        }
      },
      {
        "command": "stataCode.workingDirectoryMenu",
        "title": "Stata: Working Directory...",
        "category": "stata-code",
        "icon": {
          "light": "resources/icons/stata-folder.svg",
          "dark": "resources/icons/stata-folder.svg"
        }
      },
      {
        "command": "stataCode.showStataPwd",
        "title": "Stata: Show Working Directory",
        "category": "stata-code"
      },
      {
        "command": "stataCode.cdToWorkspace",
        "title": "Stata: cd to Workspace Folder",
        "category": "stata-code"
      },
      {
        "command": "stataCode.cdToCurrentFile",
        "title": "Stata: cd to Current File Folder",
        "category": "stata-code"
      },
      {
        "command": "stataCode.chooseWorkingDirectory",
        "title": "Stata: Choose Working Directory...",
        "category": "stata-code"
      },
      {
        "command": "stataCode.refreshSessions",
        "title": "Stata: Refresh Sessions",
        "category": "stata-code",
        "icon": "$(refresh)"
      },
      {
        "command": "stataCode.openLog",
        "title": "Stata: Open Last Log",
        "category": "stata-code",
        "icon": "$(output)"
      },
      {
        "command": "stataCode.saveLog",
        "title": "Stata: Save Last Log As...",
        "category": "stata-code",
        "icon": "$(save)"
      },
      {
        "command": "stataCode.clearLogs",
        "title": "Stata: Clear Log History",
        "category": "stata-code",
        "icon": "$(trash)"
      },
      {
        "command": "stataCode.openGraph",
        "title": "Stata: Open Graph",
        "category": "stata-code"
      },
      {
        "command": "stataCode.saveGraph",
        "title": "Stata: Save Graph As...",
        "category": "stata-code",
        "icon": "$(save)"
      },
      {
        "command": "stataCode.clearGraphs",
        "title": "Stata: Clear Graph History",
        "category": "stata-code",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "stataCode.runSelection",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == stata"
      },
      {
        "command": "stataCode.runSection",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == stata"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stataCode",
          "title": "stata-code",
          "icon": "resources/stata-code.svg"
        }
      ]
    },
    "views": {
      "stataCode": [
        {
          "id": "stataCode.sessions",
          "name": "Sessions",
          "icon": "$(database)",
          "contextualTitle": "stata-code"
        },
        {
          "id": "stataCode.lastResult",
          "name": "Last Result",
          "icon": "$(output)",
          "contextualTitle": "stata-code"
        },
        {
          "id": "stataCode.runHistory",
          "name": "Run History",
          "icon": "$(history)",
          "contextualTitle": "stata-code"
        },
        {
          "id": "stataCode.logsHistory",
          "name": "Logs",
          "icon": "$(output)",
          "contextualTitle": "stata-code"
        },
        {
          "id": "stataCode.graphsHistory",
          "name": "Graphs",
          "icon": "$(graph)",
          "contextualTitle": "stata-code"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "stataCode.lastResult",
        "contents": "No run yet. Open a Stata file and press Cmd/Ctrl+Enter to run a selection."
      },
      {
        "view": "stataCode.runHistory",
        "contents": "No run history yet. Each run will appear here for rerun, copy, and export."
      },
      {
        "view": "stataCode.logsHistory",
        "contents": "No logs yet. Run Stata code to collect output logs."
      },
      {
        "view": "stataCode.graphsHistory",
        "contents": "No graphs captured yet."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "stataCode.runFile",
          "when": "resourceLangId == stata",
          "group": "navigation@1000"
        },
        {
          "command": "stataCode.runSelection",
          "when": "resourceLangId == stata",
          "group": "navigation@1001"
        },
        {
          "command": "stataCode.runSection",
          "when": "resourceLangId == stata",
          "group": "navigation@1002"
        },
        {
          "command": "stataCode.viewDataPreview",
          "when": "resourceLangId == stata",
          "group": "navigation@1003"
        },
        {
          "command": "stataCode.showOutput",
          "when": "resourceLangId == stata",
          "group": "navigation@1004"
        },
        {
          "command": "stataCode.showGraphs",
          "when": "resourceLangId == stata",
          "group": "navigation@1005"
        },
        {
          "command": "stataCode.newSession",
          "when": "resourceLangId == stata",
          "group": "navigation@1006"
        },
        {
          "command": "stataCode.switchSession",
          "when": "resourceLangId == stata",
          "group": "navigation@1007"
        },
        {
          "command": "stataCode.cancelSession",
          "when": "resourceLangId == stata",
          "group": "navigation@1008"
        },
        {
          "command": "stataCode.resetSession",
          "when": "resourceLangId == stata",
          "group": "navigation@1009"
        },
        {
          "command": "stataCode.workingDirectoryMenu",
          "when": "resourceLangId == stata",
          "group": "navigation@1010"
        }
      ],
      "editor/context": [
        {
          "command": "stataCode.runSelection",
          "when": "editorLangId == stata",
          "group": "stataCode@1"
        },
        {
          "command": "stataCode.runFile",
          "when": "editorLangId == stata",
          "group": "stataCode@2"
        },
        {
          "command": "stataCode.runSection",
          "when": "editorLangId == stata",
          "group": "stataCode@3"
        },
        {
          "command": "stataCode.viewDataPreview",
          "when": "editorLangId == stata",
          "group": "stataCode@4"
        },
        {
          "command": "stataCode.workingDirectoryMenu",
          "when": "editorLangId == stata",
          "group": "stataCode@5"
        },
        {
          "command": "stataCode.openHelpForSelection",
          "when": "editorLangId == stata",
          "group": "stataCode@6"
        },
        {
          "command": "stataCode.insertContinuation",
          "when": "editorLangId == stata",
          "group": "stataCode@7"
        }
      ],
      "view/title": [
        {
          "command": "stataCode.newSession",
          "when": "view == stataCode.sessions",
          "group": "navigation@1"
        },
        {
          "command": "stataCode.refreshSessions",
          "when": "view == stataCode.sessions",
          "group": "navigation@2"
        },
        {
          "command": "stataCode.openLog",
          "when": "view == stataCode.logsHistory",
          "group": "navigation@1"
        },
        {
          "command": "stataCode.clearLogs",
          "when": "view == stataCode.logsHistory",
          "group": "navigation@2"
        },
        {
          "command": "stataCode.exportRunBundle",
          "when": "view == stataCode.runHistory",
          "group": "navigation@1"
        },
        {
          "command": "stataCode.clearRunHistory",
          "when": "view == stataCode.runHistory",
          "group": "navigation@2"
        },
        {
          "command": "stataCode.showGraphs",
          "when": "view == stataCode.graphsHistory",
          "group": "navigation@1"
        },
        {
          "command": "stataCode.clearGraphs",
          "when": "view == stataCode.graphsHistory",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "stataCode.switchSession",
          "when": "view == stataCode.sessions && viewItem =~ /stataCode.session/",
          "group": "inline@1"
        },
        {
          "command": "stataCode.cancelSession",
          "when": "view == stataCode.sessions && viewItem =~ /stataCode.session/",
          "group": "inline@2"
        },
        {
          "command": "stataCode.resetSession",
          "when": "view == stataCode.sessions && viewItem =~ /stataCode.session/",
          "group": "inline@3"
        },
        {
          "command": "stataCode.closeSession",
          "when": "view == stataCode.sessions && viewItem =~ /closable/",
          "group": "inline@4"
        },
        {
          "command": "stataCode.openLog",
          "when": "view == stataCode.logsHistory && viewItem == stataCode.logHistoryItem",
          "group": "inline@1"
        },
        {
          "command": "stataCode.saveLog",
          "when": "view == stataCode.logsHistory && viewItem == stataCode.logHistoryItem",
          "group": "inline@2"
        },
        {
          "command": "stataCode.rerunHistory",
          "when": "view == stataCode.runHistory && viewItem == stataCode.runHistoryItem",
          "group": "inline@1"
        },
        {
          "command": "stataCode.exportRunBundle",
          "when": "view == stataCode.runHistory && viewItem == stataCode.runHistoryItem",
          "group": "inline@2"
        },
        {
          "command": "stataCode.copyRunCode",
          "when": "view == stataCode.runHistory && viewItem == stataCode.runHistoryItem",
          "group": "run@1"
        },
        {
          "command": "stataCode.openRunResult",
          "when": "view == stataCode.runHistory && viewItem == stataCode.runHistoryItem",
          "group": "run@2"
        },
        {
          "command": "stataCode.openGraph",
          "when": "view == stataCode.graphsHistory && viewItem == stataCode.graphHistoryItem",
          "group": "inline@1"
        },
        {
          "command": "stataCode.saveGraph",
          "when": "view == stataCode.graphsHistory && viewItem == stataCode.graphHistoryItem",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "stataCode.openGraph",
          "when": "false"
        },
        {
          "command": "stataCode.saveGraph",
          "when": "false"
        },
        {
          "command": "stataCode.statusBarMenu",
          "when": "false"
        },
        {
          "command": "stataCode.runCell",
          "when": "false"
        },
        {
          "command": "stataCode.rerunHistory",
          "when": "false"
        },
        {
          "command": "stataCode.copyRunCode",
          "when": "false"
        },
        {
          "command": "stataCode.openRunResult",
          "when": "false"
        },
        {
          "command": "stataCode.openMatrix",
          "when": "false"
        },
        {
          "command": "stataCode.showStataPwd",
          "when": "false"
        },
        {
          "command": "stataCode.cdToWorkspace",
          "when": "false"
        },
        {
          "command": "stataCode.cdToCurrentFile",
          "when": "false"
        },
        {
          "command": "stataCode.chooseWorkingDirectory",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "stata-code",
      "properties": {
        "stataCode.serverCommand": {
          "type": "string",
          "default": "stata-code-mcp",
          "description": "Command used to launch the stata-code MCP server. Must be on PATH or an absolute path. Override if you installed the package into a non-default Python environment. For module launch, set this to the Python executable and put -m stata_code.mcp in serverArgs."
        },
        "stataCode.serverArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra args passed to the MCP server process."
        },
        "stataCode.sessionId": {
          "type": "string",
          "default": "main",
          "description": "Session id passed to stata_run. 'main' is the default Stata frame; other values create/route to same-named frames."
        },
        "stataCode.includeFullLog": {
          "type": "boolean",
          "default": false,
          "description": "Whether to ask the runner for the full log inline. When false (the default) the extension fetches the log on demand via get_log(ref)."
        },
        "stataCode.persistLogFiles": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save each file-backed run as immutable .log and .smcl artifacts under a log-files folder next to the source .do file."
        },
        "stataCode.persistGeneratedFiles": {
          "type": "boolean",
          "default": true,
          "description": "When persistLogFiles is enabled, copy newly created or modified table/export files from the run working directory into the run bundle's outputs folder and save captured graphs into graphs."
        },
        "stataCode.useDoFileDirectory": {
          "type": "boolean",
          "default": true,
          "description": "Before running file-backed Stata code, cd Stata to the source .do file's directory so relative table and graph exports land next to the .do file by default."
        },
        "stataCode.customCommands": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["reghdfe", "ivreghdfe", "winsor2", "outreg2", "esttab"],
          "description": "Extra community or project-specific Stata commands surfaced by VS Code completion."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "gen-types": "node scripts/gen-types.cjs",
    "test": "tsc -p . && node --test out/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
